{
  "mcpServers": {
    "godot": {
      "command": "python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/godot_server.py"
      ],
      "env": {
        "GODOT_PATH": "${GODOT_PATH:-}",
        "GODOT_EDITOR_PORT": "${GODOT_EDITOR_PORT:-9877}",
        "GAME_PROJECT_DIR": "${GAME_PROJECT_DIR:-}",
        "GODOT_EDITOR_TOKEN": "${GODOT_EDITOR_TOKEN:-}"
      }
    },
    "blender": {
      "command": "python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/blender_server.py"
      ],
      "env": {
        "BLENDER_PATH": "${BLENDER_PATH:-}",
        "BLENDER_BRIDGE_PORT": "${BLENDER_BRIDGE_PORT:-9876}",
        "BLENDER_BRIDGE_TOKEN": "${BLENDER_BRIDGE_TOKEN:-}"
      }
    },
    "comfyui": {
      "command": "python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/comfyui_server.py"
      ],
      "env": {
        "COMFYUI_URL": "${COMFYUI_URL:-http://127.0.0.1:8188}",
        "COMFY_WORKFLOWS_DIR": "${COMFY_WORKFLOWS_DIR:-}"
      }
    },
    "assets": {
      "command": "python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/assets_server.py"
      ],
      "env": {
        "FFMPEG_PATH": "${FFMPEG_PATH:-}"
      }
    },
    "gimp": {
      "command": "python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/gimp_server.py"
      ],
      "env": {
        "GIMP_PATH": "${GIMP_PATH:-}"
      }
    }
  }
}